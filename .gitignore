*.exe
*.apk
*.mp4
*.bak
*.bak.*
dist/
build/
*.spec
*.db

# Android & Gradle Caches
.gradle/
android/
build_output/

# Flutter & Dart Caches
.dart_tool/
flutter_app/

# Archives & Old builds
archive_builds/
voice_split/

