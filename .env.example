# ══════════════════════════════════════════════════════
#  Dubber Dang Pro — Environment Variables v3.1
#  Copy this file to .env and fill in your values
#  NEVER commit the actual .env file to git!
# ══════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
DEBUG=false

# ── AI / Translation ─────────────────────────────────
# Google Gemini API key (for transcription + translation)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs (optional, for premium voice cloning)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ── VoxCPM2 Cloud (Colab/Kaggle GPU) ─────────────────
# Set this to your running Colab/Kaggle ngrok URL
VOXCPM2_CLOUD_URL=https://your-ngrok-url.ngrok.io

# ── Storage (optional S3-compatible) ─────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket_name
S3_REGION=ap-southeast-1

# ── License System ───────────────────────────────────
# Admin secret for generating license keys (keep private!)
LICENSE_ADMIN_SECRET=your_admin_secret_here

# ── App Config ───────────────────────────────────────
APP_NAME=Dubber Dang Pro
APP_VERSION=3.1.0
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_TYPES=mp4,mkv,avi,mov,webm,flv

# ── Paths (auto-detected if not set) ─────────────────
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# UPLOADS_DIR=./uploads
# OUTPUTS_DIR=./outputs
